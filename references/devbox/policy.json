{
  "$schema": "schemas/policy.schema.json",
  "version": "1.0.0-minimum",
  "constitutional_red": [
    "filesystem.delete",
    "git.force_push",
    "git.rewrite_history",
    "git.discard_work",
    "credentials.expose",
    "system.modify",
    "network.public_exposure",
    "remote.execute",
    "release.production"
  ],
  "actions": {
    "filesystem.read": {"classification": "green"},
    "filesystem.write": {"classification": "green"},
    "filesystem.quarantine": {"classification": "green"},
    "filesystem.delete": {"classification": "red", "capability_override": false},
    "git.commit": {"classification": "green"},
    "git.push_feature": {"classification": "green"},
    "git.force_push": {"classification": "red", "capability_override": false},
    "git.rewrite_history": {"classification": "red", "capability_override": false},
    "git.discard_work": {"classification": "red", "capability_override": false},
    "credentials.expose": {"classification": "red", "capability_override": false},
    "system.modify": {"classification": "red", "capability_override": false},
    "network.public_exposure": {"classification": "red", "capability_override": false},
    "remote.execute": {"classification": "red", "capability_override": false},
    "release.production": {"classification": "red", "capability_override": false},
    "harness.modify": {"classification": "amber", "promote_to": "blue", "condition": "maintenance_capability"},
    "records.read": {"classification": "green"},
    "records.write": {"classification": "green"},
    "network.public_read": {"classification": "green"}
  },
  "protected_paths": [
    {"path": "~/.safe-yolo", "action": "harness.modify", "harness": "safe-yolo", "scope": "policy"},
    {"path": "~/.safe-yolo/policy.json", "action": "harness.modify", "harness": "safe-yolo", "scope": "policy"},
    {"path": "~/.safe-yolo/engine", "action": "harness.modify", "harness": "safe-yolo", "scope": "engine"},
    {"path": "~/.safe-yolo/adapters", "action": "harness.modify", "harness": "safe-yolo", "scope": "adapter"},
    {"path": "~/.safe-yolo/tests", "action": "harness.modify", "harness": "safe-yolo", "scope": "tests"},
    {"path": "~/.codex/config.toml", "action": "harness.modify", "harness": "codex", "scope": "config"},
    {"path": "~/.codex/hooks.json", "action": "harness.modify", "harness": "codex", "scope": "hooks"},
    {"path": "~/.codex/hooks", "action": "harness.modify", "harness": "codex", "scope": "hooks"},
    {"path": "~/.codex/rules", "action": "harness.modify", "harness": "codex", "scope": "rules"},
    {"path": "~/.ssh", "action": "system.modify"},
    {"path": "~/.netrc", "action": "credentials.expose"},
    {"path": "~/.npmrc", "action": "credentials.expose"},
    {"path": "~/.config/gh", "action": "credentials.expose"},
    {"path": "~/.codex/auth.json", "action": "credentials.expose"},
    {"path": "~/.azure", "action": "credentials.expose"},
    {"path": "~/.config/railway", "action": "credentials.expose"},
    {"path": "~/.docker/config.json", "action": "credentials.expose"},
    {"path": "~/.local/share/kalsigns/secrets", "action": "credentials.expose"},
    {"path": "~/.config/systemd", "action": "system.modify"}
  ]
}
