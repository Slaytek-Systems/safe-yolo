{
  "$schema": "schemas/policy.schema.json",
  "version": "0.2.0",
  "constitutional_red": [
    "filesystem.delete",
    "git.force_push",
    "git.rewrite_history",
    "git.discard_work",
    "credentials.expose",
    "system.modify"
  ],
  "actions": {
    "filesystem.read": {"classification": "green"},
    "filesystem.write": {"classification": "green"},
    "filesystem.quarantine": {"classification": "green"},
    "filesystem.delete": {"classification": "red", "capability_override": false},
    "git.commit": {"classification": "green"},
    "git.push_feature": {"classification": "blue", "condition": "safe_feature_push"},
    "git.push_tag": {"classification": "amber"},
    "git.push_protected": {"classification": "amber"},
    "git.force_push": {"classification": "red", "capability_override": false},
    "git.rewrite_history": {"classification": "red", "capability_override": false},
    "git.discard_work": {"classification": "red", "capability_override": false},
    "github.pr_create": {"classification": "blue"},
    "github.pr_merge": {"classification": "amber"},
    "deploy.preview": {"classification": "blue"},
    "deploy.production": {"classification": "amber", "promote_to": "blue", "condition": "release_evidence", "condition_fallback_capability": true},
    "records.read": {"classification": "green"},
    "records.write": {"classification": "green", "condition": "task_aligned_record_write"},
    "records.delete": {"classification": "amber"},
    "records.admin": {"classification": "amber"},
    "network.public_read": {"classification": "green"},
    "network.authenticated_read": {"classification": "amber"},
    "network.write": {"classification": "amber"},
    "network.exfiltration": {"classification": "red", "capability_override": false},
    "harness.inspect": {"classification": "green"},
    "harness.modify": {"classification": "amber", "promote_to": "blue", "condition": "maintenance_capability"},
    "harness.modify_policy": {"classification": "amber", "promote_to": "blue", "condition": "policy_maintenance_capability"},
    "credentials.read": {"classification": "amber"},
    "credentials.expose": {"classification": "red", "capability_override": false},
    "system.modify": {"classification": "red", "capability_override": false}
  },
  "protected_paths": [
    {"path": "~/.safe-yolo", "action": "harness.modify_policy", "harness": "safe-yolo", "scope": "policy"},
    {"path": "~/.codex/config.toml", "action": "harness.modify", "harness": "codex", "scope": "config"},
    {"path": "~/.codex/AGENTS.md", "action": "harness.modify", "harness": "codex", "scope": "instructions"},
    {"path": "~/.codex/hooks", "action": "harness.modify", "harness": "codex", "scope": "hooks"},
    {"path": "~/.codex/scripts", "action": "harness.modify", "harness": "codex", "scope": "scripts"},
    {"path": "~/.claude/settings.json", "action": "harness.modify", "harness": "claude", "scope": "config"},
    {"path": "~/.claude/CLAUDE.md", "action": "harness.modify", "harness": "claude", "scope": "instructions"},
    {"path": "~/.claude/hooks", "action": "harness.modify", "harness": "claude", "scope": "hooks"},
    {"path": "~/.pi/agent/extensions/guardian", "action": "harness.modify", "harness": "pi", "scope": "hooks"},
    {"path": "~/.grok/hooks", "action": "harness.modify", "harness": "grok", "scope": "hooks"},
    {"path": "~/.ssh", "action": "system.modify"},
    {"path": "~/.netrc", "action": "system.modify"},
    {"path": "~/.zshrc", "action": "system.modify"},
    {"path": "~/.zprofile", "action": "system.modify"},
    {"path": "~/.gitconfig", "action": "system.modify"},
    {"path": "~/.npmrc", "action": "system.modify"},
    {"path": "~/Library/LaunchAgents", "action": "system.modify"}
  ]
}
