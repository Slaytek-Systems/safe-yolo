{
  "$schema": "policy.schema.json",
  "version": "1.0.0",
  "constitutional_red": [
    "filesystem.delete",
    "git.force_push",
    "git.push_tag",
    "git.rewrite_history",
    "git.discard_work",
    "credentials.expose",
    "network.exfiltration",
    "network.public_exposure",
    "remote.execute",
    "system.modify"
  ],
  "actions": {
    "filesystem.read": {"classification": "green"},
    "filesystem.write": {"classification": "green"},
    "filesystem.quarantine": {"classification": "green"},
    "filesystem.delete": {"classification": "red", "capability_override": false},
    "git.commit": {"classification": "green"},
    "git.push_feature": {"classification": "blue"},
    "git.push_tag": {"classification": "red", "capability_override": false},
    "git.push_protected": {"classification": "amber"},
    "git.force_push": {"classification": "red", "capability_override": false},
    "git.rewrite_history": {"classification": "red", "capability_override": false},
    "git.discard_work": {"classification": "red", "capability_override": false},
    "github.pr_create": {"classification": "blue"},
    "github.pr_merge": {"classification": "amber"},
    "deploy.preview": {"classification": "blue"},
    "deploy.production": {"classification": "amber", "promote_to": "blue", "condition": "external_release_contract", "condition_fallback_capability": false},
    "records.read": {"classification": "green"},
    "records.write": {"classification": "green", "condition": "task_aligned_record_write"},
    "records.delete": {"classification": "amber"},
    "records.admin": {"classification": "amber"},
    "network.public_read": {"classification": "green"},
    "network.authenticated_read": {"classification": "amber"},
    "network.write": {"classification": "amber"},
    "network.exfiltration": {"classification": "red", "capability_override": false},
    "network.public_exposure": {"classification": "red", "capability_override": false},
    "remote.execute": {"classification": "red", "capability_override": false},
    "harness.inspect": {"classification": "green"},
    "harness.modify": {"classification": "amber", "promote_to": "blue", "condition": "maintenance_capability"},
    "harness.modify_policy": {"classification": "amber", "promote_to": "blue", "condition": "policy_maintenance_capability"},
    "credentials.read": {"classification": "amber"},
    "credentials.expose": {"classification": "red", "capability_override": false},
    "system.modify": {"classification": "red", "capability_override": false}
  },
  "protected_paths": [
    {"path": "${SAFE_YOLO_HOME}", "action": "harness.modify_policy", "harness": "safe-yolo", "scope": "release"},
    {"path": "${CODEX_HOME}/config.toml", "action": "harness.modify", "harness": "codex", "scope": "config"},
    {"path": "${CODEX_HOME}/AGENTS.md", "action": "harness.modify", "harness": "codex", "scope": "instructions"},
    {"path": "${CODEX_HOME}/hooks.json", "action": "harness.modify", "harness": "codex", "scope": "hooks"},
    {"path": "${CODEX_HOME}/hooks", "action": "harness.modify", "harness": "codex", "scope": "hooks"},
    {"path": "${CODEX_HOME}/rules", "action": "harness.modify", "harness": "codex", "scope": "rules"},
    {"path": "${CODEX_HOME}/auth.json", "action": "credentials.expose", "harness": "codex", "scope": "credentials"},
    {"path": "${HOME}/.cursor/hooks.json", "action": "harness.modify", "harness": "cursor", "scope": "hooks"},
    {"path": "${HOME}/.cursor/hooks", "action": "harness.modify", "harness": "cursor", "scope": "hooks"},
    {"path": "${HOME}/.cursor/mcp.json", "action": "harness.modify", "harness": "cursor", "scope": "config"},
    {"path": "${HOME}/.cursor/rules", "action": "harness.modify", "harness": "cursor", "scope": "rules"},
    {"path": "${HOME}/.cursor/cli-config.json", "action": "harness.modify", "harness": "cursor", "scope": "config"}
  ]
}
