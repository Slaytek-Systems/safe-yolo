{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-yolo.invalid/decision.schema.json",
  "title": "Safe YOLO consequence decision",
  "type": "object",
  "required": ["decision", "policy_id", "reason"],
  "properties": {
    "decision": {
      "enum": ["allow", "allow_report", "require_capability", "block_method", "block_hard"]
    },
    "policy_id": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "classification": {"enum": ["green", "blue", "amber", "red"]},
    "capability_override": {"type": "boolean"},
    "effect": {"type": "string"}
  },
  "additionalProperties": true
}
