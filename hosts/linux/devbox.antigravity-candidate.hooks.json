{
  "safe-yolo": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /home/dev/.safe-yolo/bootstrap.py --release /home/dev/.safe-yolo/releases/3.0.0-alpha.6 --manifest-sha256 REPLACE_AFTER_INSTALL --entry antigravity_v3 --state-dir /home/dev/.safe-yolo/state",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
